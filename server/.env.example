# Server port
PORT=5000

# MongoDB connection string (local example shown; swap for your Atlas URI if needed)
MONGODB_URI=mongodb://127.0.0.1:27017/resumate

# Secret used to sign JWTs — set this to any long random string
JWT_SECRET=change-me-to-a-long-random-string

# How long issued tokens stay valid
JWT_EXPIRES_IN=7d

# Google Gemini API key — get one free (no credit card) at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Where the frontend runs (used for CORS)
CLIENT_URL=http://localhost:5173
