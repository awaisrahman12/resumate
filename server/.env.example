# Server port
PORT=5000

# MongoDB connection string (local example shown; swap for your Atlas URI if needed)
MONGODB_URI=mongodb://127.0.0.1:27017/resumate

# Secret used to sign JWTs — set this to any long random string
JWT_SECRET=change-me-to-a-long-random-string

# How long issued tokens stay valid
JWT_EXPIRES_IN=7d

# Google Gemini API key — get one free (no credit card) at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Email (OTP verification) ---
# Gmail address used to send verification codes, plus a Google APP PASSWORD
# (not your normal Gmail password). Create one at:
#   https://myaccount.google.com/apppasswords  (requires 2-Step Verification)
SMTP_USER=
SMTP_PASS=
# Optional friendly From header
SMTP_FROM=ResuMate <your-address@gmail.com>

# --- Google sign-in ---
# OAuth 2.0 Client ID from https://console.cloud.google.com/apis/credentials
# The SAME value must also be set as VITE_GOOGLE_CLIENT_ID in client/.env
GOOGLE_CLIENT_ID=

# Where the frontend runs (used for CORS)
CLIENT_URL=http://localhost:5173
